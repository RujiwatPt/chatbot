# Supabase — from Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# OpenRouter — https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Optional: override the default model
# OPENROUTER_MODEL=sao10k/l3.3-euryale-70b

# Optional: comma-separated fallback chain. Tried in order if the primary fails.
# Defaults to sophosympatheia/midnight-rose-70b, neversleep/llama-3-lumimaid-70b, gryphe/mythomax-l2-13b, google/gemma-4-31b-it:free, openrouter/free
# OPENROUTER_FALLBACK_MODELS=sophosympatheia/midnight-rose-70b,neversleep/llama-3-lumimaid-70b,gryphe/mythomax-l2-13b,google/gemma-4-31b-it:free,openrouter/free
