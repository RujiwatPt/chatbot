# Supabase — from Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# OpenRouter — https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Optional: override the default free model
# OPENROUTER_MODEL=google/gemma-4-31b-it:free

# Optional: comma-separated fallback chain. Tried in order if the primary fails.
# Defaults to nvidia/nemotron-3-super-120b-a12b:free, inclusionai/ling-3.0-flash:free, openrouter/free
# OPENROUTER_FALLBACK_MODELS=nvidia/nemotron-3-super-120b-a12b:free,inclusionai/ling-3.0-flash:free,openrouter/free
