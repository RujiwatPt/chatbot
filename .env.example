# Supabase — from Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# OpenRouter — https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Optional: override the default model
# OPENROUTER_MODEL=sao10k/l3.3-euryale-70b

# Optional: comma-separated fallback chain (OpenRouter caps models array at 3 items total: 1 primary + 2 fallbacks).
# Defaults to sophosympatheia/midnight-rose-70b, neversleep/llama-3-lumimaid-70b, gryphe/mythomax-l2-13b
# OPENROUTER_FALLBACK_MODELS=sophosympatheia/midnight-rose-70b,neversleep/llama-3-lumimaid-70b,gryphe/mythomax-l2-13b

# Secret master key used to derive per-user AES-256-GCM encryption keys (at least 32 chars recommended)
# ENCRYPTION_SECRET=your-secret-master-encryption-key-here

