{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "chatbot",
  "main": ".open-next/worker.js",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "r2_buckets": [
    {
      "binding": "AVATARS_BUCKET",
      "bucket_name": "chatbot-avatars"
    }
  ],
  "vars": {
    "NEXT_PUBLIC_SUPABASE_URL": "https://uznbmjskesqzrsecxaam.supabase.co",
    "NEXT_PUBLIC_SUPABASE_ANON_KEY": "sb_publishable_bhAq4g_mqHw_ymbXba5TQA_Zwl5rGFa"
  }
}