{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "chatbot",
  "main": ".open-next/worker.js",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "keep_vars": true,
  "placement": {
    "mode": "smart"
  },
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "r2_buckets": [
    {
      "binding": "AVATARS_BUCKET",
      "bucket_name": "chatbot-avatars"
    }
  ]
}